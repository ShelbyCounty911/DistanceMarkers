FACTORY_DEF {*} TeeFactory    FACTORY_NAME { expose_attrs_4 }    INPUT  FEATURE_TYPE SC911_Trail_Markers_Output    OUTPUT { FEATURE_TYPE expose_attrs_4_OUTPUT          }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO AttributeRemover_5_LIST_FUNC }    } else {        puts "MACRO AttributeRemover_5_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AttributeRemover_5 }    INPUT  FEATURE_TYPE expose_attrs_4_OUTPUT    OUTPUT { FEATURE_TYPE AttributeRemover_5_OUTPUT        @RemoveAttributes(fme_encoded,_copynum,_count,_http_status_code,_offset,_page_size,_pages,_response_body,json_index,json_type)        $(AttributeRemover_5_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { AttributeManager_5 }    INPUT  FEATURE_TYPE AttributeRemover_5_OUTPUT    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ACTION_COLUMN 4    DEF_VAL_COLUMN 2    NUM_OF_COLUMNS 5    MISSING_INPUT_ATTR_HANDLING RENAME_SET_VALUE REMOVE    ATTR_ACTION { "" "Type" "Trail" "varchar<openparen>25<closeparen>" "SET_TO" }      ATTR_ACTION { "" "Marker" "<at>Value<openparen>SIGN<closeparen>" "varchar<openparen>5<closeparen>" "SET_TO" }      ATTR_ACTION { "" "MarkerExt" "FME_NULL_VALUE" "varchar<openparen>5<closeparen>" "SET_TO" }      ATTR_ACTION { "" "Name" "<at>Value<openparen>TRAIL<closeparen>" "varchar<openparen>100<closeparen>" "SET_TO" }      ATTR_ACTION { "" "Label" "<at>Value<openparen>LABEL<closeparen>" "" "SET_TO" }      ATTR_ACTION { "" "ShelbyID" "<at>Value<openparen>Marker<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_primname" "<at>Trim<openparen><at>ReplaceRegularExpression<openparen><at>Value<openparen>Label<closeparen><comma><backslash>d+<openparen>?:<backslash>.<backslash>d+<closeparen>?<openbracket>a-zA-Z<closebracket>*<comma><quote><quote><comma>caseSensitive=FALSE<closeparen><closeparen>" "varchar<openparen>100<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altname1" "<at>Value<openparen>Name<closeparen>" "varchar<openparen>100<closeparen>" "SET_TO" }      ATTR_ACTION { "SIGN" "SIGN" "" "varchar<openparen>254<closeparen>" "REMOVE" }      ATTR_ACTION { "TRAIL" "TRAIL" "" "varchar<openparen>200<closeparen>" "REMOVE" }      ATTR_ACTION { "NAME" "NAME" "" "varchar<openparen>200<closeparen>" "REMOVE" }      ATTR_ACTION { "LABEL" "LABEL" "" "varchar<openparen>200<closeparen>" "REMOVE" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeManager_5_OUTPUT        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} DuplicateRemoverFactory    FACTORY_NAME { DuplicateFilter_2 }    COMMAND_PARM_EVALUATION SINGLE_PASS    SUPPORTS_FEATURE_TABLES    INPUT  FEATURE_TYPE AttributeManager_5_OUTPUT    KEY_ATTRIBUTES { ShelbyID }    INPUT_IS_ORDERED { NO }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { UNIQUE FEATURE_TYPE DuplicateFilter_2_UNIQUE         }
