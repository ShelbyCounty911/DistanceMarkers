FACTORY_DEF * BranchingFactory   FACTORY_NAME "SC911_Trail_Markers_Output Brancher -1 185"   INPUT FEATURE_TYPE SC911_Trail_Markers_Output   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
