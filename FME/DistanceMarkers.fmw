   if {{OUTGOING} == {OUTGOING}} {      set attrs [list {_offset}];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    if {{NO_OP} == {NO_OP}} {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV;    } else {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV_MULTI_FEATURE;    };    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {<at>Value<openparen>_copynum<closeparen><space>*<space><at>Value<openparen>_page_size<closeparen>};     lappend parmList {FLOAT};    };    lappend parmList {$(GET_from_REST_WORKSPACE_NAME)_calc_offset};    if {{NO_OP} == {OTHER_NULL_VALUE_2}} {     lappend parmList {NO_OP};     lappend parmList {<Unused>};     lappend parmList {0};    };    puts "MACRO __fme_expressionevaluator_evaluateArgs__ [join $parmList ,]";
END_INCLUDE
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(GET_from_REST_WORKSPACE_NAME)_calc_offset }    INPUT  FEATURE_TYPE "$(GET_from_REST_WORKSPACE_NAME)_clone_based_on_pages_COPY"    OUTPUT { FEATURE_TYPE "$(GET_from_REST_WORKSPACE_NAME)_calc_offset_OUTPUT"         @EvaluateExpression($(__fme_expressionevaluator_evaluateArgs__))          }
MACRO __fme_expressionevaluator_evaluateArgs__
