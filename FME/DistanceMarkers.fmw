#! <GLOBAL_PARAMETERS>
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI LITERAL OPTIONAL NAMEDGROUP GROUP_1 TARGET_URL%MESSAGE_1 REST endpoint URL"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI URL_OR_ATTR_ENCODED TARGET_URL https%http Request URL"
#!   DEFAULT_VALUE="https:&lt;solidus&gt;&lt;solidus&gt;services2.arcgis.com&lt;solidus&gt;nf3p7v7Zy4fTOh6M&lt;solidus&gt;arcgis&lt;solidus&gt;rest&lt;solidus&gt;services&lt;solidus&gt;Mile_Marker&lt;solidus&gt;FeatureServer&lt;solidus&gt;0"
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI OPTIONAL NAMEDMESSAGE MESSAGE_1 Note: Expecting a URL to a REST endpoint ending in the indexed layer selection.&#10;&#10;E.g.: https://services2.arcgis.com/nf3p7v7Zy4fTOh6M/arcgis/rest/services/Mile_Marker/FeatureServer/0"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI LITERAL OPTIONAL NAMEDGROUP GROUP_2 WHERE_QUERY%MESSAGE_2 Where query"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI OPTIONAL TEXT_TRIMMED_OR_ATTR WHERE_QUERY Where query"
#!   DEFAULT_VALUE="COUNTY=79"
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI OPTIONAL NAMEDMESSAGE MESSAGE_2 Note: MUST be a valid SQL query. To return all features, use &quot;1=1&quot;&#10;&#10;Other examples:&#10;- COUNTY=79&#10;- COUNTRY=&apos;USA&apos;&#10;- STATE in (&apos;TN&apos;, &apos;MS&apos;, &apos;AR&apos;)"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! </GLOBAL_PARAMETERS>
#! <USER_PARAMETERS
#!   FORM=""
#! >
#! <PARAMETER_INFO>
