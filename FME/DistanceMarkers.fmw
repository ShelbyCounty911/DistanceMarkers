# -------------------------------------------------------------------------
# First determine which function we are going to be using -- we can do
# this statically at parse time for efficiency sake
MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr
MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function
MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr
MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr
INCLUDE [ set sourceText {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_geom<closeparen>,$(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer)};           set decodedText [FME_DecodeText "$sourceText"];           if ![regexp {@EvaluateExpression\([^)]*STRING_ENCODED,@Value\(([^()]*)\),[^()]*\)} "$decodedText" dummy geomSrcAttr] {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr @SupplyAttributes(ENCODED,__GeometryReplacerTemp__,\"$sourceText\")";               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr @RemoveAttributes(__GeometryReplacerTemp__)";               set geomSrcAttr __GeometryReplacerTemp__;           } elseif {{Yes} == {Yes} } {                puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr @RemoveAttributes(\"$geomSrcAttr\")";           };           if {{GEOJSON} == {fmebinary} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_BINARY,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {fmehex} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_BINARY_HEX,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {fmexml} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {fmexmlencoded} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ENCODED_STRING,&\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {polyline} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_POLYLINE,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {wkt} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,GEOJSON,\"$geomSrcAttr\",<Unused>)";           } elseif {{GEOJSON} == {wkb} ||                      {GEOJSON} == {wkbhex} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,GEOJSON,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {GEOJSON} ||                     {GEOJSON} == {ESRIJSON} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @JSONGeometry(FROM_ATTRIBUTE,GEOJSON,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {GEORSS} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @GeoRSSGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {KML} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @KMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {GML} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @GMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{GEOJSON} == {geohash} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @GeoHash(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{GEOJSON} == {ogeosms} ||                     {GEOJSON} == {geosms}  ||                     {GEOJSON} == {geo} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,GEOJSON,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {mgrs}} {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @MGRS(FROM_MGRS, <Unused>, <Unused>,\"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_geom<closeparen>,$(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer)\")"           } elseif {{GEOJSON} == {mssql} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @SerializeGeometry(from_attribute,GEOJSON,\"$geomSrcAttr\",<Unused>)";           } elseif {{GEOJSON} == {iso6709} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @GeographicPoint(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{GEOJSON} == {qlikmaps} } {               puts "MACRO $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_QLIKMAPS_POLYLINE,\"$geomSrcAttr\")";           }; ]
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Rejector }    COMMAND_PARM_EVALUATION SINGLE_PASS    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    INPUT  FEATURE_TYPE "$(GET_from_REST_WORKSPACE_NAME)_JSONExtractor_EVALUATED"    $($(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr)    FUNCTION_DEFINITION { $($(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_Function) }    OUTPUT { COMPLETE FEATURE_TYPE "$(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_OUTPUT"        $($(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr) $($(GET_from_REST_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr) }
