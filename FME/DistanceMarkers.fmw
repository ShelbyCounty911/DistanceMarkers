ren><space>MM<space><at>Value<openparen>Marker<closeparen>.<at>Value<openparen>MarkerExt<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>5<closecurly>.Name" "<at>Value<openparen>_fullname_prim<closeparen><space><at>Value<openparen>Marker<closeparen>.<at>Value<openparen>MarkerExt<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>6<closecurly>.Name" "<at>Value<openparen>_fullname_alt1<closeparen><space><at>Value<openparen>Marker<closeparen>.<at>Value<openparen>MarkerExt<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>7<closecurly>.Name" "Mile<space><at>Value<openparen>Marker<closeparen>.<at>Value<openparen>MarkerExt<closeparen><space><at>Value<openparen>_fullname_prim<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>8<closecurly>.Name" "Mile<space><at>Value<openparen>Marker<closeparen>.<at>Value<openparen>MarkerExt<closeparen><space><at>Value<openparen>_fullname_alt1<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>9<closecurly>.Name" "Mile<space>Marker<space><at>Value<openparen>Marker<closeparen>.<at>Value<openparen>MarkerExt<closeparen><space><at>Value<openparen>_fullname_prim<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>10<closecurly>.Name" "Mile<space>Marker<space><at>Value<openparen>Marker<closeparen>.<at>Value<openparen>MarkerExt<closeparen><space><at>Value<openparen>_fullname_alt1<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>11<closecurly>.Name" "MM<space><at>Value<openparen>Marker<closeparen>.<at>Value<openparen>MarkerExt<closeparen><space><at>Value<openparen>_fullname_prim<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>12<cl