FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { alt_names_attrs_mngr_4 }    INPUT  FEATURE_TYPE DuplicateFilter_2_UNIQUE    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ACTION_COLUMN 4    DEF_VAL_COLUMN 2    NUM_OF_COLUMNS 5    MISSING_INPUT_ATTR_HANDLING RENAME_SET_VALUE REMOVE    ATTR_ACTION { "ShelbyID" "ShelbyID" "" "varchar<openparen>200<closeparen>" "NO_OP" }      ATTR_ACTION { "" "_altnames<opencurly>0<closecurly>.Name" "<at>Value<openparen>_altname1<closeparen><space><at>Value<openparen>Marker<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>1<closecurly>.Name" "<at>Value<openparen>_primname<closeparen><space>Marker<space><at>Value<openparen>Marker<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>2<closecurly>.Name" "<at>Value<openparen>_primname<closeparen><space>Trail<space><at>Value<openparen>Marker<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>3<closecurly>.Name" "<at>Value<openparen>Marker<closeparen><space><at>Value<openparen>_altname1<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "" "_altnames<opencurly>4<closecurly>.Name" "<at>Value<openparen>Marker<closeparen><space><at>Value<openparen>_primname<closeparen>" "varchar<openparen>200<closeparen>" "SET_TO" }      ATTR_ACTION { "Type" "Type" "" "varchar<openparen>25<closeparen>" "REMOVE" }      ATTR_ACTION { "Marker" "Marker" "" "varchar<openparen>5<closeparen>" "REMOVE" }      ATTR_ACTION { "MarkerExt" "MarkerExt" "" "varchar<openparen>5<closeparen>" "REMOVE" }      ATTR_ACTION { "Name" "Name" "" "varchar<openparen>100<closeparen>" "REMOVE" }      ATTR_ACTION { "Label" "Label" "" "varchar<openparen>200<closeparen>" "REMOVE" }      ATTR_ACTION { "_primname" "_primname" "" "varchar<openparen>100<closeparen>"